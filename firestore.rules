rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: productos
// Document ID: auto-generated
// Access: Public read; Authenticated admin full read/write.
//
// Collection: config
// Document ID: 'store' (and any other admin config docs)
// Access: Public read on 'store'; Authenticated admin full read/write.
//
// Collection: pedidos
// Document ID: auto-generated
// Fields (on public create):
//   - productoId: string (required, max 200 chars)
//   - nombreProducto: string (required, max 500 chars)
//   - marca: string (required, max 200 chars)
//   - codigo: string (required, max 200 chars)
//   - talla: string (required, max 200 chars)
//   - precio: number (required, >= 0)
//   - foto: string (required, max 500000 chars to support URLs or base64 data)
//   - fecha: number (required, > 0)
//   - estado: string (required, must be 'pendiente' on public create)
// Access: Public create only (validated); Authenticated admin full read/write.
//
// Collection: verificaciones_credito
// Document ID: auto-generated
// Fields (on public create):
//   - creditoId: string (required, 1..200 chars)
//   - clienteNombre: string (required, 1..300 chars)
//   - clienteCedula: string (required, 3..50 chars)
//   - clienteTelefono: string (required, 5..50 chars)
//   - clienteDireccion: string (required, 3..500 chars)
//   - clienteCiudad: string (required, 1..200 chars)
//   - ref1Nombre: string (required, 1..300 chars)
//   - ref1Parentesco: string (required, 1..100 chars)
//   - ref1Telefono: string (required, 5..50 chars)
//   - ref2Nombre: string (required, 1..300 chars)
//   - ref2Parentesco: string (required, 1..100 chars)
//   - ref2Telefono: string (required, 5..50 chars)
//   - fotoCedula: string (required, 0..350000 chars, compressed base64 data URL)
//   - fotoSelfie: string (required, 0..350000 chars, compressed base64 data URL)
//   - firmaDataUrl: string (required, 10..250000 chars, canvas signature data URL)
//   - aceptaTerminos: bool (required, must be true)
//   - fechaFirma: number (required, > 0)
//   - userAgent: string (required, 0..500 chars)
// Access: Public create only (validated); Authenticated admin full read/write. Never publicly readable/deletable (PII).
//
// Collections: proveedores, ventas, creditos, transacciones
// Document ID: auto-generated
// Access: Authenticated admin full read/write only.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is an authenticated administrator
    function isAdmin() {
      return request.auth != null;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validate public order creation from store.js
    function isValidPublicPedido() {
      let allowedFields = [
        'productoId',
        'nombreProducto',
        'marca',
        'codigo',
        'talla',
        'precio',
        'foto',
        'fecha',
        'estado'
      ];
      return hasRequiredFields(allowedFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength('productoId', 1, 200) &&
        validStringLength('nombreProducto', 1, 500) &&
        validStringLength('marca', 0, 200) &&
        validStringLength('codigo', 0, 200) &&
        validStringLength('talla', 1, 200) &&
        request.resource.data.precio is number &&
        request.resource.data.precio >= 0 &&
        validStringLength('foto', 0, 500000) &&
        request.resource.data.fecha is number &&
        request.resource.data.fecha > 0 &&
        request.resource.data.estado == 'pendiente';
    }

    // Validate public credit verification submission from credito.html
    function isValidPublicVerificacion() {
      let allowedFields = [
        'creditoId',
        'clienteNombre',
        'clienteCedula',
        'clienteTelefono',
        'clienteDireccion',
        'clienteCiudad',
        'ref1Nombre',
        'ref1Parentesco',
        'ref1Telefono',
        'ref2Nombre',
        'ref2Parentesco',
        'ref2Telefono',
        'fotoCedula',
        'fotoSelfie',
        'firmaDataUrl',
        'aceptaTerminos',
        'fechaFirma',
        'userAgent'
      ];
      return hasRequiredFields(allowedFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength('creditoId', 1, 200) &&
        validStringLength('clienteNombre', 1, 300) &&
        validStringLength('clienteCedula', 3, 50) &&
        validStringLength('clienteTelefono', 5, 50) &&
        validStringLength('clienteDireccion', 3, 500) &&
        validStringLength('clienteCiudad', 1, 200) &&
        validStringLength('ref1Nombre', 1, 300) &&
        validStringLength('ref1Parentesco', 1, 100) &&
        validStringLength('ref1Telefono', 5, 50) &&
        validStringLength('ref2Nombre', 1, 300) &&
        validStringLength('ref2Parentesco', 1, 100) &&
        validStringLength('ref2Telefono', 5, 50) &&
        validStringLength('fotoCedula', 0, 350000) &&
        validStringLength('fotoSelfie', 0, 350000) &&
        validStringLength('firmaDataUrl', 10, 250000) &&
        request.resource.data.aceptaTerminos is bool &&
        request.resource.data.aceptaTerminos == true &&
        request.resource.data.fechaFirma is number &&
        request.resource.data.fechaFirma > 0 &&
        validStringLength('userAgent', 0, 500);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public catalog products: public can read, admin has full access
    match /productos/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Store configuration: public can read config/store, admin has full access
    match /config/{docId} {
      allow read: if docId == 'store' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Customer orders via WhatsApp: public can only create valid pending orders, admin has full access
    match /pedidos/{docId} {
      allow create: if isAdmin() || isValidPublicPedido();
      allow read, update, delete: if isAdmin();
    }

    // Credit verification & digital promissory note: public can only create valid verifications, admin has full access
    match /verificaciones_credito/{docId} {
      allow create: if isAdmin() || isValidPublicVerificacion();
      allow read, update, delete: if isAdmin();
    }

    // Admin-only collections
    match /proveedores/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /ventas/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /creditos/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /transacciones/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
